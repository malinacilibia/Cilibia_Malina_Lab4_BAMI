@model IEnumerable<Cilibia_Malina_Lab4.Models.PredictionHistory>

@{
    ViewData["Title"] = "History";
}

<h2>Istoric predicții</h2>

<form method="get" asp-action="History" class="row g-3 mb-3">

    <div class="col-md-3">
        <label class="form-label">Tip plată</label>
        <select name="paymentType" class="form-select">
            <option value="">Toate</option>
            <option value="CRD" selected="@(ViewBag.CurrentPaymentType == "CRD")">Card</option>
            <option value="CSH" selected="@(ViewBag.CurrentPaymentType == "CSH")">Cash</option>
            <option value="OTHER" selected="@(ViewBag.CurrentPaymentType == "OTHER")">Altele</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Preț minim</label>
        <input type="number" step="0.01" name="minPrice" value="@(ViewBag.CurrentMinPrice ?? "")" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Preț maxim</label>
        <input type="number" step="0.01" name="maxPrice" value="@(ViewBag.CurrentMaxPrice ?? "")" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">De la data</label>
        <input type="date" name="startDate" value="@ViewBag.CurrentStartDate" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Pana la data</label>
        <input type="date" name="endDate" value="@ViewBag.CurrentEndDate" class="form-control" />
    </div>

    <div class="col-md-1 align-self-end">
        <button type="submit" class="btn btn-primary">Filtrează</button>
    </div>
</form>

<br />

<table class="table">
    <thead>
        <tr>
            <th>
                Data
                <a asp-action="History"
                   asp-route-sortOrder="date_asc"
                   asp-route-paymentType="@ViewBag.CurrentPaymentType"
                   asp-route-minPrice="@ViewBag.CurrentMinPrice"
                   asp-route-maxPrice="@ViewBag.CurrentMaxPrice"
                   asp-route-startDate="@ViewBag.CurrentStartDate"
                   asp-route-endDate="@ViewBag.CurrentEndDate">↑</a>
                <a asp-action="History"
                   asp-route-sortOrder="date_desc"
                   asp-route-paymentType="@ViewBag.CurrentPaymentType"
                   asp-route-minPrice="@ViewBag.CurrentMinPrice"
                   asp-route-maxPrice="@ViewBag.CurrentMaxPrice"
                   asp-route-startDate="@ViewBag.CurrentStartDate"
                   asp-route-endDate="@ViewBag.CurrentEndDate">↓</a>
            </th>
            <th>Pasageri</th>
            <th>Distanță</th>
            <th>Timp (sec)</th>
            <th>Tip Plată</th>
            <th>
                Preț Prezis
                <a asp-action="History"
                   asp-route-sortOrder="price_asc"
                   asp-route-paymentType="@ViewBag.CurrentPaymentType"
                   asp-route-minPrice="@ViewBag.CurrentMinPrice"
                   asp-route-maxPrice="@ViewBag.CurrentMaxPrice"
                   asp-route-startDate="@ViewBag.CurrentStartDate"
                   asp-route-endDate="@ViewBag.CurrentEndDate">↑</a>
                <a asp-action="History"
                   asp-route-sortOrder="price_desc"
                   asp-route-paymentType="@ViewBag.CurrentPaymentType"
                   asp-route-minPrice="@ViewBag.CurrentMinPrice"
                   asp-route-maxPrice="@ViewBag.CurrentMaxPrice"
                   asp-route-startDate="@ViewBag.CurrentStartDate"
                   asp-route-endDate="@ViewBag.CurrentEndDate">↓</a>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CreatedAt</td>
                <td>@item.PassengerCount</td>
                <td>@item.TripDistance</td>
                <td>@item.TripTimeInSecs</td>
                <td>@item.PaymentType</td>
                <td>@item.PredictedPrice</td>
            </tr>
        }
    </tbody>
</table>